rules_version = '2';

// ===========================================================================
// TUCASA TIA Mbeya — Firestore security rules
//
// Test:    npm run test:rules          (Firestore emulator, needs Java 21+)
// Deploy:  npm run deploy:rules
//
// Access model — every account (member, associate, reader, leader) is active
// immediately after registration; there is no approval step.
//   • Public  → announcements tagged 'reader'
//   • Member  → any signed-in user with a profile reads posts tagged with their role
//   • Self    → read own profile; register once; edit only phone + location
//   • Leader  → (role 'leader') read everything; manage OTHER users (role, fee);
//               delete non-leaders; publish posts
//   • Nobody  → sets their own fee as paid or edits their own role after registering
//
// Leader registration: the Leader Verification Passcode is checked in the browser only
// (Registration.jsx). These rules accept any self-registered profile with
// role 'leader' + status 'approved' — they do NOT verify the passcode.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function isLeader() {
      return hasProfile() && myProfile().role == 'leader';
    }

    // Official TIA Mbeya course codes per qualification level (mirror of src/data/constants.js).
    function coursesFor(level) {
      return level == 'certificate'
        ? ['BTCAC', 'BTCPLM', 'BTCBA', 'BTCHRM', 'BTCMK', 'BTCPSAF']
        : level == 'diploma'
          ? ['DAC', 'DPLM', 'DBA', 'DHRM', 'DMK', 'DPSAF']
          : ['BAC', 'BPLM', 'BBA', 'BHRM', 'BMPR', 'BPSAF'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Empty, or an HTTPS image hosted on Cloudinary.
    function isValidPhotoUrl(value) {
      return value is string
        && value.size() <= 500
        && (value == '' || value.matches('^https://res[.]cloudinary[.]com/.+'));
    }

    // ------------------------------------------------- users: validation
    // location: { residentialArea, houseNumber } — the single-field housing schema.
    // (The retired roomNumber key is removed by My Profile on save.)
    function isValidLocation(loc) {
      return loc is map
        && loc.keys().hasOnly(['residentialArea', 'houseNumber'])
        && isShortString(loc.get('residentialArea', ''), 100)
        && isShortString(loc.get('houseNumber', ''), 100);
    }

    // academicDetails: { level, courseCode, course, yearOfStudy }; the code must belong to the level.
    function isValidAcademic(a) {
      let level = a.get('level', 'degree');
      return a is map
        && a.keys().hasOnly(['level', 'courseCode', 'course', 'yearOfStudy'])
        && level in ['certificate', 'diploma', 'degree']
        && (!('courseCode' in a) || a.courseCode in coursesFor(level))
        && isShortString(a.get('course', ''), 120)
        && isShortString(a.get('yearOfStudy', ''), 10);
    }

    // Exact shape written by Registration.jsx.
    function isValidRegistration(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'uid', 'fullName', 'email', 'phone', 'role', 'status', 'membershipFeePaid', 'feeStatus',
          'profilePictureUrl', 'academicDetails', 'location', 'ministryWing', 'createdAt'
        ])
        // Semester fee ledger always starts unpaid.
        && (!('feeStatus' in d) || d.feeStatus == 'unpaid')
        && d.keys().hasAll(['uid', 'fullName', 'email', 'role', 'membershipFeePaid', 'createdAt'])
        && d.uid == uid
        && isShortString(d.fullName, 120) && d.fullName.size() > 0
        && isShortString(d.email, 254)
        && d.role in ['reader', 'member', 'associate', 'leader']
        // Leaders are stored as approved; nobody else carries a status.
        && (d.role == 'leader'
              ? d.get('status', '') == 'approved'
              : !('status' in d))
        // Nobody can register themselves as paid.
        && d.membershipFeePaid == false
        && (!('profilePictureUrl' in d) || isValidPhotoUrl(d.profilePictureUrl))
        && (!('academicDetails' in d) || isValidAcademic(d.academicDetails))
        && (!('location' in d) || isValidLocation(d.location))
        && d.createdAt == request.time;
    }

    // My Profile page: phone + housing (area, house number) only.
    // role, status, fee, photo, academics, uid, etc. are untouchable.
    function isValidSelfUpdate() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['phone', 'location', 'updatedAt'])
        && isShortString(d.phone, 20)
        && (!('location' in changedKeys()) || isValidLocation(d.location))
        && (!('updatedAt' in changedKeys()) || d.updatedAt == request.time);
    }

    // Leaders manage OTHER users. Fee changes must carry an audit trail.
    function isValidLeaderUpdate(uid) {
      let d = request.resource.data;
      return !isSelf(uid)
        && !changedKeys().hasAny(['uid', 'email', 'createdAt'])
        && d.role in ['reader', 'member', 'associate', 'leader']
        && d.membershipFeePaid is bool
        && (!('profilePictureUrl' in d) || isValidPhotoUrl(d.profilePictureUrl))
        // Semester ledger: one of three states, and the legacy flag must agree with it.
        && (!('feeStatus' in d)
              || (d.feeStatus in ['unpaid', 'semester1_paid', 'fully_paid']
                  && d.membershipFeePaid == (d.feeStatus == 'fully_paid')))
        && (
          !changedKeys().hasAny(['membershipFeePaid', 'feeStatus'])
          || (d.feeUpdatedBy == request.auth.uid && d.feeUpdatedAt == request.time)
        );
    }

    // ------------------------------------------ announcements: validation
    function isValidAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'title', 'category', 'content', 'visibleTo', 'imageUrl',
          'authorId', 'authorName', 'publishedAt', 'updatedAt', 'updatedBy',
          'scheduledAt', 'expiresAt', 'issuedBy', 'eventDate'
        ])
        // Source authority (mirror of ISSUING_AUTHORITIES in src/data/constants.js).
        && (!('issuedBy' in d) || d.issuedBy in [
              'Katibu / Church Secretary', 'Mwenyekiti (Chairperson)', 'Makamu Mwenyekiti',
              'Hazina (Treasurer)', 'Idara ya Ustawi (Welfare)', 'Idara ya Muziki/Kwaya',
              'Evangelism Leader', 'Media/Technical Team'
            ])
        // Optional "Tarehe ya Tukio" (event date).
        && (!('eventDate' in d) || d.eventDate is timestamp)
        // Optional scheduling window. NOTE: rules cannot filter queries, so hiding
        // scheduled/expired posts from feeds is done by the client.
        && (!('scheduledAt' in d) || d.scheduledAt is timestamp)
        && (!('expiresAt' in d) || d.expiresAt is timestamp)
        && (!('scheduledAt' in d) || !('expiresAt' in d) || d.expiresAt > d.scheduledAt)
        // Optional event poster: empty or a Cloudinary HTTPS image.
        && (!('imageUrl' in d) || isValidPhotoUrl(d.imageUrl))
        && d.keys().hasAll(['title', 'category', 'content', 'visibleTo', 'authorId', 'publishedAt'])
        && isShortString(d.title, 120) && d.title.size() > 0
        && isShortString(d.content, 3000) && d.content.size() > 0
        && d.category in ['Sabbath Service', 'Choir', 'Welfare', 'Evangelism', 'Fellowship', 'General']
        && d.visibleTo is list
        && d.visibleTo.size() > 0
        && d.visibleTo.hasOnly(['reader', 'member', 'associate']);
    }

    // --------------------------------------------- directory: validation
    // Public-to-members "Flock Directory" card. Only non-sensitive keys are allowed —
    // phone, housing and fee status can never be written here. Name and photo must
    // mirror the owner's profile (getAfter also sees a profile created in the same batch).
    function isValidDirectoryEntry(uid) {
      let d = request.resource.data;
      let profile = getAfter(profilePath(uid)).data;
      return existsAfter(profilePath(uid))
        && d.keys().hasOnly([
          'uid', 'fullName', 'profilePictureUrl', 'courseCode', 'courseName',
          'academicLevel', 'ministryWing', 'updatedAt'
        ])
        && d.keys().hasAll(['uid', 'fullName', 'updatedAt'])
        && d.uid == uid
        && d.fullName == profile.fullName
        && d.get('profilePictureUrl', '') == profile.get('profilePictureUrl', '')
        && isShortString(d.get('courseCode', ''), 20)
        && isShortString(d.get('courseName', ''), 120)
        && d.get('academicLevel', '') in ['', 'certificate', 'diploma', 'degree']
        && isShortString(d.get('ministryWing', ''), 40)
        && d.updatedAt == request.time;
    }

    // ------------------------------------------- engagement: validation
    // users/{uid}/engagement/{YYYY-MM}: monthly counts recorded by leaders.
    function isValidEngagement(monthId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['month', 'attendance', 'welfare', 'ministry', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['month', 'attendance', 'welfare', 'ministry', 'updatedBy', 'updatedAt'])
        && d.month == monthId
        && d.attendance is int && d.attendance >= 0 && d.attendance <= 31
        && d.welfare is int && d.welfare >= 0 && d.welfare <= 31
        && d.ministry is int && d.ministry >= 0 && d.ministry <= 31
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    // ------------------------------------------ worship roster: validation
    // worshipSchedules/{YYYY-MM-DD}: one duty roster per Sabbath (mirror of src/lib/worship.js).
    function isDuty(section, key) {
      return isShortString(section.get(key, ''), 120);
    }

    function isSabbathId(id) {
      let parts = id.split('-');
      return id.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])
      allow get: if isSelf(uid) || isLeader();
      allow list: if isLeader();

      allow create: if isSelf(uid) && isValidRegistration(uid);

      allow update: if (isSelf(uid) && isValidSelfUpdate())
                    || (isLeader() && isValidLeaderUpdate(uid));

      // Leaders may remove members from the registry — never themselves or another leader.
      allow delete: if isLeader()
                    && !isSelf(uid)
                    && resource.data.role != 'leader';
    }

    // ======================================================== announcements
    match /announcements/{announcementId} {
      allow read: if 'reader' in resource.data.visibleTo
                  || isLeader()
                  || (hasProfile() && myProfile().role in resource.data.visibleTo);

      allow create: if isLeader()
                    && isValidAnnouncement()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.publishedAt == request.time;

      // Edit Mode: original author/date are preserved; edits are stamped with the editor.
      allow update: if isLeader()
                    && isValidAnnouncement()
                    && !changedKeys().hasAny(['authorId', 'authorName', 'publishedAt'])
                    && (!('updatedBy' in changedKeys()) || request.resource.data.updatedBy == request.auth.uid)
                    && (!('updatedAt' in changedKeys()) || request.resource.data.updatedAt == request.time);

      allow delete: if isLeader();
    }

    // ==================================================== flock directory
    match /directory/{uid} {
      // Any registered profile may browse; entries hold no sensitive fields.
      allow read: if hasProfile();
      allow create, update: if (isSelf(uid) || isLeader()) && isValidDirectoryEntry(uid);
      allow delete: if isSelf(uid) || isLeader();
    }

    // ================================================ engagement analytics
    match /users/{uid}/engagement/{monthId} {
      allow read: if isSelf(uid) || isLeader();
      allow create, update: if isLeader()
                            && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])
  }
}
)
                            && isValidEngagement(monthId);
      allow delete: if isLeader();
    }

    // ====================================================== worship roster
    match /worshipSchedules/{sabatoDate} {
      // Every registered account can read the roster; only leaders manage it.
      allow read: if hasProfile();

      allow create: if isLeader()
                    && isValidWorshipSchedule(sabatoDate)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time;

      allow update: if isLeader()
                    && isValidWorshipSchedule(sabatoDate)
                    && !changedKeys().hasAny(['sabatoDate', 'createdBy', 'createdByName', 'createdAt'])
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isLeader();
    }

    // Everything else is closed by default.
  }
}
)
        // timestamp.dayOfWeek(): 1 = Monday ... 6 = Saturday, 7 = Sunday.
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])).dayOfWeek() == 6;
    }

    function isValidWorshipSchedule(id) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'sabatoDate', 'midweek', 'sabbathSchool', 'divineService',
          'createdBy', 'createdByName', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && d.keys().hasAll(['sabatoDate', 'midweek', 'sabbathSchool', 'divineService', 'createdBy', 'createdAt'])
        && d.sabatoDate == id
        && isSabbathId(id)
        && d.midweek is map
        && d.midweek.keys().hasOnly(['wednesdayPrayer', 'fridayVespers'])
        && isDuty(d.midweek, 'wednesdayPrayer') && isDuty(d.midweek, 'fridayVespers')
        && d.sabbathSchool is map
        && d.sabbathSchool.keys().hasOnly(['chair', 'memoryVerse', 'missionStory', 'lessonStudy'])
        && isDuty(d.sabbathSchool, 'chair') && isDuty(d.sabbathSchool, 'memoryVerse')
        && isDuty(d.sabbathSchool, 'missionStory') && isDuty(d.sabbathSchool, 'lessonStudy')
        && d.divineService is map
        && d.divineService.keys().hasOnly(['chair', 'mainScripture', 'preacher', 'offering'])
        && isDuty(d.divineService, 'chair') && isDuty(d.divineService, 'mainScripture')
        && isDuty(d.divineService, 'preacher') && isDuty(d.divineService, 'offering')
        && isShortString(d.get('createdByName', ''), 120);
    }

    // ================================================================ users
    match /users/{uid} {
      allow get: if isSelf(uid) || isLeader();
      allow list: if isLeader();

      allow create: if isSelf(uid) && isValidRegistration(uid);

      allow update: if (isSelf(uid) && isValidSelfUpdate())
                    || (isLeader() && isValidLeaderUpdate(uid));

      // Leaders may remove members from the registry — never themselves or another leader.
      allow delete: if isLeader()
                    && !isSelf(uid)
                    && resource.data.role != 'leader';
    }

    // ======================================================== announcements
    match /announcements/{announcementId} {
      allow read: if 'reader' in resource.data.visibleTo
                  || isLeader()
                  || (hasProfile() && myProfile().role in resource.data.visibleTo);

      allow create: if isLeader()
                    && isValidAnnouncement()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.publishedAt == request.time;

      // Edit Mode: original author/date are preserved; edits are stamped with the editor.
      allow update: if isLeader()
                    && isValidAnnouncement()
                    && !changedKeys().hasAny(['authorId', 'authorName', 'publishedAt'])
                    && (!('updatedBy' in changedKeys()) || request.resource.data.updatedBy == request.auth.uid)
                    && (!('updatedAt' in changedKeys()) || request.resource.data.updatedAt == request.time);

      allow delete: if isLeader();
    }

    // ==================================================== flock directory
    match /directory/{uid} {
      // Any registered profile may browse; entries hold no sensitive fields.
      allow read: if hasProfile();
      allow create, update: if (isSelf(uid) || isLeader()) && isValidDirectoryEntry(uid);
      allow delete: if isSelf(uid) || isLeader();
    }

    // ================================================ engagement analytics
    match /users/{uid}/engagement/{monthId} {
      allow read: if isSelf(uid) || isLeader();
      allow create, update: if isLeader()
                            && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])
  }
}
)
                            && isValidEngagement(monthId);
      allow delete: if isLeader();
    }

    // Everything else is closed by default.
  }
}
